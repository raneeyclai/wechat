.note-bullets {
  padding-left: 40rpx;
}
.bullet-item {
  margin: 16rpx 0;
  line-height: 1.6;
  color: #333;
}
.note-paragraph {
  line-height: 1.8;
  white-space: pre-wrap; /* Preserves \n newlines */
}
.note-title {
  font-weight: bold;
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #1aad19;
}