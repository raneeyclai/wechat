<block wx:for="{{item.notes}}" wx:key="title">
    <view class="note-card" data-url="{{item.content}}" bindtap="onNoteTap">
      <view class="note-title">{{item.title}}</view>
      <view class="note-content">{{item.content}}</view>
    </view>
    
    <!-- Bullet list -->
    <view wx:if="{{item.type === 'bullets'}}" class="note-bullets">
      <view wx:for="{{item.content}}" wx:key="*this" class="bullet-item">
        • {{item}}
      </view>
    </view>
    
    <!-- Paragraph -->
    <view wx:elif="{{item.type === 'paragraph'}}" class="note-paragraph">
      <text>{{item.content}}</text>
    </view>
  </view>
</block>