.skeleton-container {
  padding: 30rpx;
}

.skeleton-card {
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255,255,255,0.6);
}

.skeleton-title {
  height: 80rpx;
  width: 60%;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: loading 1.5s infinite;
  border-radius: 12rpx;
  margin: 32rpx;
}

.skeleton-line {
  height: 32rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: loading 1.5s infinite;
  border-radius: 6rpx;
  margin: 0 32rpx 20rpx;
}

.skeleton-line-1 { width: 80%; }
.skeleton-line-2 { width: 60%; }

@keyframes loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* Real cards polish */
.plan-card {
  margin: 0 30rpx 24rpx;
  transition: all 0.3s ease;
}

.plan-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.plan-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.plan-icon {
  width: 72rpx;
  height: 72rpx;
  background: var(--primaryColor);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: #999;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.5;
  margin-bottom: 40rpx;
}